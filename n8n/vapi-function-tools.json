  {
    "type": "function",
    "function": {
      "name": "save_order",
      "description": "Save a pickup or delivery order only after the caller explicitly confirms the complete order and total.",
      "parameters": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean",
            "description": "True only after the caller explicitly confirms the complete order."
          },
          "confirmed_total": {
            "type": "number",
            "description": "Total in euros that the caller explicitly confirmed."
          },
          "customer_name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": ["pickup", "delivery"]
          },
          "address": {
            "type": "string",
            "description": "Required for delivery orders."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                }
              },
              "required": ["name", "quantity"],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["confirmed", "confirmed_total", "type", "items"],
        "additionalProperties": false
      }
    },
    "server": {
      "url": "https://YOUR_N8N_HOST/webhook/vapi-server"
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_booking",
      "description": "Save a table reservation only after the caller explicitly confirms all reservation details.",
      "parameters": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean",
            "description": "True only after the caller explicitly confirms the complete reservation."
          },
          "customer_name": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "Reservation date in YYYY-MM-DD format."
          },
          "time": {
            "type": "string",
            "description": "Reservation time in HH:MM format."
          },
          "party_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "notes": {
            "type": "string"
          }
        },
        "required": ["confirmed", "customer_name", "date", "time", "party_size"],
        "additionalProperties": false
      }
    },
    "server": {
      "url": "https://YOUR_N8N_HOST/webhook/vapi-server"
    }
  }
]
